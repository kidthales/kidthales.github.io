---
// Standalone minimal HTML redirect stub: 0 external fonts, 0 CSS bundles, 0 JS
const targetUrl = '/works/spiderex/';
const canonicalUrl = 'https://kidthales.github.io/works/spiderex/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to Spiderex Trainer...</title>
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalUrl} />
  </head>
  <body>
    <p>
      Redirecting to <a href={targetUrl}>Spiderex Trainer</a>...
    </p>
  </body>
</html>
