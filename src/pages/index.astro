---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestPublishedEntries, isSuperseded, isCorrected } from '../lib/entries';

const latestWords = await getLatestPublishedEntries(5);
---

<BaseLayout
  title="Home"
  description="Personal website and digital garden of kidthales, exploring software architecture, web craft, and systems design."
>
  <article class="prose">
    <header>
      <h1>kidthales</h1>
      <p>
        Personal website and digital garden of kidthales. This space hosts long-form essays,
        architectural field notes, and technical observations across software design and systems craft.
        Explore ongoing writings and publications in Words.
      </p>
    </header>

    <section aria-labelledby="latest-words-heading">
      <h2 id="latest-words-heading">Latest Words</h2>
      {latestWords.length === 0 ? (
        <p>No published Entries yet.</p>
      ) : (
        <ul>
          {latestWords.map((entry) => (
            <li>
              <a href={`/words/${entry.id}/`}>{entry.data.title}</a>
              {isSuperseded(entry) && <span class="marker"> [Superseded]</span>}
              {isCorrected(entry) && <span class="marker"> [Corrected]</span>}
            </li>
          ))}
        </ul>
      )}
      <p>
        <a href="/words/">Browse all Words &rarr;</a>
      </p>
    </section>
  </article>
</BaseLayout>
