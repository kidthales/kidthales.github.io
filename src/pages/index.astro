---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLatestPublishedEntries, isSuperseded, isCorrected } from '../lib/entries';
import { getLatestPublishedWorks, KIND_GLYPHS } from '../lib/works';

const latestWords = await getLatestPublishedEntries(5);
const latestWorks = await getLatestPublishedWorks(5);
---

<BaseLayout
  title="Home"
  description="Personal website and digital garden of kidthales, exploring software architecture, web craft, and systems design."
>
  <article class="prose">
    <header>
      <h1>kidthales</h1>
      <p>
        Personal website and digital garden of kidthales. This space hosts long-form essays,
        architectural field notes, and technical observations across software design and systems craft,
        along with interactive tools, applications, and games in Works.
      </p>
    </header>

    <section aria-labelledby="latest-words-heading">
      <h2 id="latest-words-heading">Latest Words</h2>
      {latestWords.length === 0 ? (
        <p>No published Entries yet.</p>
      ) : (
        <ul>
          {latestWords.map((entry) => (
            <li>
              <a href={`/words/${entry.id}/`}>{entry.data.title}</a>
              {isSuperseded(entry) && <span class="marker"> [Superseded]</span>}
              {isCorrected(entry) && <span class="marker"> [Corrected]</span>}
            </li>
          ))}
        </ul>
      )}
      <p>
        <a href="/words/">Browse all Words &rarr;</a>
      </p>
    </section>

    <section aria-labelledby="latest-works-heading">
      <h2 id="latest-works-heading">Latest Works</h2>
      {latestWorks.length === 0 ? (
        <p>No published Works yet.</p>
      ) : (
        <ul>
          {latestWorks.map((work) => {
            const glyph = KIND_GLYPHS[work.data.kind];
            return (
              <li>
                <span aria-hidden="true">{glyph}</span>{' '}
                {work.data.external_url ? (
                  <a href={work.data.external_url} rel="external">
                    {work.data.title} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a href={`/works/${work.id}/`}>{work.data.title}</a>
                )}
                {' '}&mdash; {work.data.description}
              </li>
            );
          })}
        </ul>
      )}
      <p>
        <a href="/works/">Browse all Works &rarr;</a>
      </p>
    </section>
  </article>
</BaseLayout>
