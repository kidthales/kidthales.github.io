<%- include('../templates/header.ejs', {
title: "Spiderex",
subtitle: 'Daily guitar fingering drills',
description: 'Daily guitar fingering drills'
}) %>

<div data-controller="spiderex">
    <div class="row row-cols-1 justify-content-center">
        <div class="col-md-4">
            <form>
                <input type="date" name="date" placeholder="yyyy-mm-dd" aria-label="Date" data-spiderex-target="query">
                <input type="submit" value="Query Date">
            </form>
        </div>
    </div>
    <div class="row row-cols-1">
        <div class="col-12">
            <section>
                <h2>Warmup</h2>
                <p>
                    Play each pattern ascending & descending across all strings, with straight & triplet feel. Once you
                    are comfortable with the patterns, phase in some string skipping.
                </p>
                <div data-spiderex-target="warmupResults"></div>
            </section>
        </div>
        <div class="col-12">
            <section>
                <h2>Twister</h2>
                <p>
                    Built from the warmup patterns listed above.
                </p>
                <div data-spiderex-target="twisterResults"></div>
            </section>
        </div>
    </div>
</div>

<%- include('../templates/footer.ejs') %>
