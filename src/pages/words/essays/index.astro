---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getPublishedEntriesByForm,
  isSuperseded,
  isCorrected,
  formatDate,
  FORM_LABELS,
  FORM_GLYPHS,
} from '../../../lib/entries';

const essays = await getPublishedEntriesByForm('essay');
const label = FORM_LABELS.essay;
const glyph = FORM_GLYPHS.essay;
---

<BaseLayout
  title="Essays | Words"
  description="Long-form essays, analyses, and critiques on software architecture and digital craft by kidthales."
>
  <article class="prose">
    <header>
      <h1><span aria-hidden="true">{glyph}</span> {label}s</h1>
      <p>
        Long-form essays, critiques, and in-depth analyses examining software craft and systemic invariants.
      </p>

      <nav aria-label="Words sections" class="words-nav">
        <ul>
          <li><a href="/words/">All</a></li>
          <li><a href="/words/notes/">Notes</a></li>
          <li><a href="/words/essays/" aria-current="page">Essays</a></li>
          <li><a href="/words/papers/">Papers</a></li>
        </ul>
      </nav>
    </header>

    <section aria-labelledby="essays-heading">
      <h2 id="essays-heading" class="sr-only">Essays</h2>
      {essays.length === 0 ? (
        <p>No published Essays yet.</p>
      ) : (
        <ul class="entry-list">
          {essays.map((entry) => (
            <li>
              <span class="entry-form">
                <span aria-hidden="true">{glyph}</span> {label}
              </span>
              {' '}&bull;{' '}
              <time datetime={formatDate(entry.data.published_on)}>
                {formatDate(entry.data.published_on)}
              </time>
              {' '}&bull;{' '}
              <a href={`/words/${entry.id}/`}>{entry.data.title}</a>
              {isSuperseded(entry) && <span class="marker"> [Superseded]</span>}
              {isCorrected(entry) && <span class="marker"> [Corrected]</span>}
            </li>
          ))}
        </ul>
      )}
    </section>
  </article>
</BaseLayout>
